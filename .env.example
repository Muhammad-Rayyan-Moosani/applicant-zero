# Copy to .env and fill in.

# ─── How the agents reach Claude ───────────────────────────────────────────────
# cli  = the `claude` CLI on your subscription (FLAT cost — recommended for a private server).
#        Requires `claude` installed and logged in on that machine:  claude  → /login
# api  = the Anthropic API (per-token). Needs ANTHROPIC_API_KEY below.
LLM_BACKEND=cli

# For LLM_BACKEND=cli (optional):
CLAUDE_CLI=                       # path to the `claude` binary (blank = auto-detect)
CLI_MODEL=                        # blank = the CLI's default model

# For LLM_BACKEND=api:
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Telegram remote control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard bind (0.0.0.0 so it's reachable across your Tailscale mesh; no public ports).
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Browser: set to 0 to watch it, 1 for headless.
HEADLESS=0

# Relevancy: drop jobs below this tier (1-5).
MIN_TIER=3
# ATS: minimum keyword score (%) before Agent 6 greenlights.
MIN_ATS_SCORE=85
